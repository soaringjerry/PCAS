ect\":\"P1|N1 或 null\"}\n{\"op\":\"create_project\",\"name\":\"…\"}\n{\"op\":\"add_steps\",\"ref\":\"T3|THIS|R1|N1\",\"steps\":[\"…\"]}\n{\"op\":\"delegate\",\"ref\":\"T3|THIS|R1|N1|new\",\"title\":\"ref 为 new 必填\",\"kind\":\"plan|draft|breakdown|summary|ask\",\"prompt\":\"…\"}\nask 为 null 或 {\"question\":\"…\",\"options\":[\"…\"]}。",
