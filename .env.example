# Copy to .env, generate independent secrets, chmod 600 .env. Never commit it.
PCAS_DB_PASSWORD=replace-with-generated-hex-secret
PCAS_OWNER_ID=2e194d58-849d-45b7-a4ce-bfe4d53c063d
# openssl rand -hex 32; also the browser login password.
PCAS_API_TOKEN=replace-with-generated-64-character-secret
PCAS_BIND_ADDRESS=127.0.0.1
PCAS_PORT=12352
# Set to the exact public origin when behind a reverse proxy.
PCAS_PUBLIC_URL=
PCAS_MODELS_PATH=./config/models.example.json
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PCAS_MODEL_API_KEY=
# Optional environment keys; credentials can also be saved in Settings.
# Text API uses PCAS_MODEL_API_KEY; OpenAI embeddings use OPENAI_API_KEY.
# Native Go development (Compose uses its own internal addresses).
PCAS_DATABASE_URL=postgres://pcas:local-password@127.0.0.1:54329/pcas?sslmode=disable
PCAS_HTTP_ADDR=127.0.0.1:8090
PCAS_BLOB_DIR=data/blobs
PCAS_INBOX_DIR=data/inbox
PCAS_CODEX_HOME=data/codex
# Keep Codex as the subscription channel; direct OAuth is opt-in.
PCAS_CHATGPT_DIRECT_ENABLED=false
PCAS_CHATGPT_DIR=data/chatgpt
PCAS_CHATGPT_CALLBACK_PORT=1455
PCAS_CHATGPT_CALLBACK_BIND=127.0.0.1
PCAS_MODELS_FILE=config/models.example.json
PCAS_MODEL_SETTINGS_FILE=data/model-api.json
